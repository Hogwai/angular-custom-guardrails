{
  "name": "no-absolute-scss-url",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/no-absolute-scss-url/src",
  "projectType": "library",
  "tags": ["type:guardrail"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/no-absolute-scss-url",
        "main": "libs/no-absolute-scss-url/src/index.ts",
        "tsConfig": "libs/no-absolute-scss-url/tsconfig.lib.json",
        "assets": ["libs/no-absolute-scss-url/*.md"]
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/libs/no-absolute-scss-url/src/check.js"
      }
    }
  }
}
